# Copy this file to .env and fill in your key(s). .env is gitignored — never
# commit real tokens, here or anywhere else.

# Hugging Face access token (optional). Read by src/config.py. The learned
# branch's backbone (facebook/wav2vec2-base-960h) is a public model and loads
# fine with this left blank; setting it only lifts the unauthenticated-request
# rate limit on the Hugging Face Hub. Get one at https://huggingface.co/settings/tokens
# (a "Read" token is sufficient).
HF_TOKEN=
