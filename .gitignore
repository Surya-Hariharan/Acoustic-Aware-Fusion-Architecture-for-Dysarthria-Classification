# Dataset (large audio files stay out of git)
data/
!data/.gitkeep
!data/raw/.gitkeep
!data/extracted/.gitkeep

# Safety net: never commit raw corpus audio/alignment files, wherever they land
*.wav
*.mlf

# Generated outputs
outputs/

# ...except the VAD span table (src/vad_cache.py). It is 239 KB of integers,
# it is what keeps the dataloader from re-running Silero twice per utterance
# per epoch, and rebuilding it costs ~25 minutes of a 40,000 s Kaggle budget.
# Committing it means a fresh clone — or a Kaggle session — starts with it
# already in place. Git needs the parent directories un-ignored to reach it.
!outputs/
outputs/*
!outputs/feature_cache/
outputs/feature_cache/*
!outputs/feature_cache/vad_spans.parquet

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
notebooks/Kaggle_Training_Pipeline.ipynb
notebooks/speech-processing.ipynb
.pytest_cache/
venv/
.venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
